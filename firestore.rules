rules_version = '2';

// ============================================================================
// PEDIDOS DE OBRA · SKY TERRA — Reglas de seguridad de Firestore
// Pegar en: console.firebase.google.com → Firestore Database → Reglas → Publicar
//
// Estas reglas se aplican EN EL SERVIDOR de Firebase: aunque alguien
// modifique la app en su navegador, no puede saltearlas.
//
// Resumen:
// - Sin login no se lee ni se escribe nada. Usuario desactivado: no escribe.
// - control: SOLO lectura (no puede escribir nada, en ninguna colección).
// - director: crea pedidos solo en SUS obras asignadas; edita/borra solo sus
//   borradores; registra recepciones en pedidos de sus obras; cancela solo
//   sus propios pedidos. No puede poner "pedido_proveedor".
// - admin: gestiona obras, rubros, proveedores y usuarios; hace todas las
//   transiciones. Nadie (ni el admin) cambia su PROPIO rol o activo.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() {
      return request.auth != null;
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Activo y con rol que escribe (control queda afuera de TODA escritura)
    function esAdmin() {
      return logueado() && miPerfil().rol == 'admin' && miPerfil().activo == true;
    }

    function esDirector() {
      return logueado() && miPerfil().rol == 'director' && miPerfil().activo == true;
    }

    function asignadoAObra(obraId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/obras/$(obraId)).data.directores;
    }

    // ---------------------------------------------------------------- usuarios
    match /usuarios/{uid} {
      allow read: if logueado();

      // Cada uno crea SOLO su perfil al registrarse, con rol válido y activo.
      allow create: if logueado()
        && request.auth.uid == uid
        && request.resource.data.rol in ['director', 'admin', 'control']
        && request.resource.data.activo == true;

      // El dueño edita su perfil (nombre, whatsapp, avisos) pero NUNCA su
      // propio rol ni su propio activo. El admin edita a los demás.
      allow update: if
        (logueado()
          && request.auth.uid == uid
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.activo == resource.data.activo)
        || (esAdmin() && request.auth.uid != uid);

      allow delete: if false;

      // Notificaciones in-app (campana)
      match /notificaciones/{nid} {
        // Solo el dueño lee su campana.
        allow read: if logueado() && request.auth.uid == uid;
        // Cualquier usuario activo que escribe (admin/director) puede
        // notificar a otro. Control no.
        allow create: if esAdmin() || esDirector();
        // Solo el dueño marca leída / limpia.
        allow update, delete: if logueado() && request.auth.uid == uid;
      }
    }

    // ------------------------------------------------------------------- obras
    match /obras/{obraId} {
      allow read: if logueado();
      allow create, update: if esAdmin();
      // Admin puede borrar una obra cargada por error. Los pedidos viejos NO
      // se rompen: cada pedido guarda su propio obraNombre, así que el
      // historial se sigue leyendo aunque la obra ya no exista. Para una obra
      // que sí trabajó, lo correcto sigue siendo "finalizada", no borrarla.
      allow delete: if esAdmin();
    }

    // ------------------------------------------------------------------ rubros
    match /rubros/{rubroId} {
      allow read: if logueado();
      allow write: if esAdmin();
    }

    // ------------------------------------------------------------- proveedores
    match /proveedores/{provId} {
      allow read: if logueado();
      allow write: if esAdmin();
    }

    // ------------------------------------------------- contador de numeración
    match /contadores/{contadorId} {
      allow read: if logueado();
      allow write: if esAdmin() || esDirector();
    }

    // ----------------------------------------------------------------- pedidos
    match /pedidos/{pedidoId} {
      allow read: if logueado();

      // Nace como borrador o enviado. El director, solo en sus obras y a su
      // nombre; el admin puede crear en cualquier obra (incluye el seed).
      allow create: if
        request.resource.data.estado in ['borrador', 'enviado']
        && (esAdmin()
            || (esDirector()
                && request.resource.data.solicitanteUid == request.auth.uid
                && asignadoAObra(request.resource.data.obraId)));

      // Transiciones:
      // - admin: todas.
      // - director: (a) editar/enviar SU borrador, (b) recepciones en obras
      //   asignadas (resultado entrega_parcial/entregado), (c) cancelar SU
      //   pedido, (d) reclamar (NO cambia estado, solo agrega historial) en
      //   obras asignadas. Nunca puede poner 'pedido_proveedor'.
      allow update: if esAdmin()
        || (esDirector() && (
             (resource.data.estado == 'borrador'
               && resource.data.solicitanteUid == request.auth.uid
               && request.resource.data.estado in ['borrador', 'enviado'])
          || (request.resource.data.estado in ['entrega_parcial', 'entregado']
               && resource.data.estado in ['pedido_proveedor', 'entrega_parcial']
               && asignadoAObra(resource.data.obraId))
          || (request.resource.data.estado == 'cancelado'
               && resource.data.solicitanteUid == request.auth.uid)
          || (request.resource.data.estado == resource.data.estado
               && resource.data.estado in ['pedido_proveedor', 'entrega_parcial']
               && asignadoAObra(resource.data.obraId)
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['historial']))
        ));

      // Solo se borran borradores, y solo su dueño (o admin).
      allow delete: if resource.data.estado == 'borrador'
        && (esAdmin() || resource.data.solicitanteUid == request.auth.uid);

      // ------------------------------------------------------------ recepciones
      match /recepciones/{recId} {
        allow read: if logueado();
        allow create: if esAdmin()
          || (esDirector()
              && asignadoAObra(get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.obraId));
        allow update, delete: if false; // las recepciones no se editan
      }

      // ------------------------------------------------- fotos de remito
      match /fotos/{fotoId} {
        allow read: if logueado();
        allow create: if esAdmin()
          || (esDirector()
              && asignadoAObra(get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.obraId));
        allow update, delete: if false;
      }
    }
  }
}
