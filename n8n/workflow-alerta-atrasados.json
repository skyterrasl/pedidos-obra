      "id": "query-admins",
      "name": "Buscar admins",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Destinatarios: usuarios rol admin, activos, con whatsapp cargado en su Perfil.\nconst sv = (f, k) => (f && f[k] && f[k].stringValue) || '';\nconst admins = [];\nfor (const item of $input.all()) {\n  const doc = item.json.document;\n  if (!doc) continue;\n  const f = doc.fields || {};\n  const activo = f.activo && f.activo.booleanValue;\n  const wa = sv(f, 'whatsapp').replace(/[^0-9]/g, '');\n  if (sv(f, 'rol') === 'admin' && activo && wa) admins.push(wa);\n}\n// Pedidos vencidos (fechaEstimada < hoy) del nodo anterior.\nconst hoy = new Date().toISOString().slice(0, 10);\nconst atrasados = [];\nfor (const item of $('Buscar pedidos abiertos').all()) {\n  const doc = item.json.document;\n  if (!doc) continue;\n  const f = doc.fields || {};\n  const prov = f.proveedor && f.proveedor.mapValue && f.proveedor.mapValue.fields;\n  const fecha = prov && prov.fechaEstimada ? prov.fechaEstimada.stringValue : null;\n  if (fecha && fecha < hoy) {\n    atrasados.push(`\\u2022 *${sv(f, 'numero') || '?'}* ${sv(f, 'obraNombre')} \\u2014 estimado ${fecha} (${prov && prov.nombre ? prov.nombre.stringValue : ''})`);\n  }\n}\nif (!atrasados.length || !admins.length) return [];\nconst texto = `\\u23F0 *Pedidos de Obra \\u2014 ${atrasados.length} pedido(s) ATRASADO(s)*\\n\\n${atrasados.join('\\n')}\\n\\nhttps://skyterrasl.github.io/pedidos-obra/`;\nreturn admins.map((n) => ({ json: { number: n, text: texto } }));"
      },
      "id": "filtrar-atrasados",
      "name": "Filtrar atrasados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 140]
    },
